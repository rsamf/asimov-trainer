# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Training artifacts
runs/
*.rrd
*.usd
*.ckpt

# Retargeting artifacts (regenerable from LAFAN1)
data/motions/g1-keypoints/
data/motions/g1-keypoints-full/
data/motions/asimov-v1-pyroki/
# `asimov-v1-pyroki-full/` is the policy-frequency retarget that ships in the
# training container — track its .npz so CI checkouts get the motion data.
data/motions/asimov-v1-pyroki-full/*
!data/motions/asimov-v1-pyroki-full/*.npz

# Local Claude / IDE state
.claude/settings.local.json

# Terraform local state, plan caches, provider mirror, and tfvars (may hold
# secrets). The provider lock file (.terraform.lock.hcl) is intentionally
# tracked.
*.tfvars
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Hydra
outputs/
